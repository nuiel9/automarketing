# Every field on app.config.Settings, documented here. Real setup steps for
# each provider live in docs/PLATFORM_SETUP.md (Task 14). Copy this file to
# backend/.env and fill in real values for local development; never commit
# .env. (Settings.model_config uses env_file=".env", resolved relative to the
# process CWD — backend/ when running uvicorn or pytest from there — so a
# copy to the repo root is silently never loaded.)
#
# Comments are on their own line above each key (not inline) so that an
# unedited empty value never picks up the comment text as its literal value.

# SQLAlchemy URL for the compose Postgres instance
DATABASE_URL=postgresql+psycopg://automarketing:automarketing@localhost:5433/automarketing
# bearer token required on admin-only endpoints
ADMIN_TOKEN=dev-admin-token
# bearer token required on the /internal/tick publisher endpoint
TICK_TOKEN=dev-tick-token
# base URL this backend is reachable at (used to build public media URLs)
PUBLIC_BASE_URL=http://localhost:8000
# origin allowed by CORS for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000
# (frontend only) URL where the backend is reachable; used by Next.js client to call /api routes
NEXT_PUBLIC_API_URL=http://localhost:8000

# "local" | "gcs"
MEDIA_BACKEND=local
# local disk path used when MEDIA_BACKEND=local
MEDIA_ROOT=./media
# GCS bucket name used when MEDIA_BACKEND=gcs
GCS_BUCKET=

# path to the strategy.yaml config file
STRATEGY_PATH=./strategy.yaml
# caption LLM provider: "gemini" (default) or "anthropic"
CAPTION_PROVIDER=gemini
# Google Gemini API key for caption generation (default provider)
GEMINI_API_KEY=
# Gemini model for captions (matches eduverse-one's text model)
GEMINI_MODEL=gemini-3.6-flash
# Anthropic API key — only needed when CAPTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# comma-separated: facebook,instagram,x,line,dryrun
ENABLED_CHANNELS=dryrun

# Platform credentials — see docs/PLATFORM_SETUP.md for how to obtain each value
# Meta (Facebook) Page ID
META_PAGE_ID=
# Meta Instagram Business user ID
META_IG_USER_ID=
# Meta Graph API long-lived access token
META_ACCESS_TOKEN=

# X (Twitter) API consumer key
X_CONSUMER_KEY=
# X (Twitter) API consumer secret
X_CONSUMER_SECRET=
# X (Twitter) API access token
X_ACCESS_TOKEN=
# X (Twitter) API access token secret
X_ACCESS_TOKEN_SECRET=

# LINE Messaging API channel access token
LINE_CHANNEL_ACCESS_TOKEN=
# LINE user ID that receives publish-failure alerts
LINE_FOUNDER_USER_ID=

# --- Video factory (Phase 2) ---
# Gemini model for scenario/tips generation
TIPS_MODEL=gemini-3.6-flash
# Gemini model for text-to-speech narration
TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS voice name (matches eduverse-one's Kavee voice)
KAVEE_VOICE=Charon

# how render jobs are dispatched: "cloudrun" | "local"
RENDER_DISPATCHER=cloudrun
# GCP project ID that hosts the render Cloud Run job
GCP_PROJECT=
# Cloud Run job name used for rendering
RENDER_JOB_NAME=automarketing-render
# Cloud Run job region
RENDER_JOB_REGION=asia-southeast1

# eduverse-one login used to drive demo renders — this is a PRODUCTION
# account with paid credits, not a sandbox/test account. Each demo render
# consumes those credits, so treat this credential with the same care as a
# billing secret and do not use it for manual/ad-hoc testing.
DEMO_EMAIL=
# password for the eduverse-one demo account above (production, has credits)
DEMO_PASSWORD=

# --- Motion Ad (AIVDO) ---
# AIVDO API key. Create it in the AIVDO UI; store in Secret Manager as
# AIVDO_API_KEY. Each ad costs 5 credits from that account.
AIVDO_API_KEY=
# AIVDO API base URL
AIVDO_BASE_URL=https://aivdo-api-b7iz53omoq-as.a.run.app
# ad template: cafe|luxe|synthwave|food|y2k|review|editorial|blueprint|custom
AIVDO_STYLE=blueprint
# Gemini TTS voice for the ad voiceover (Kavee's voice)
AIVDO_VOICE=Charon
# seconds to wait for an ad render before failing the item (kept below the
# render Cloud Run job's --task-timeout=15m so poll()'s own timeout error
# fires instead of the task being killed first)
AIVDO_POLL_TIMEOUT=600
# public page screenshotted as the ad photo (no login required)
AD_SHOT_URL=https://eduverse.one/th
